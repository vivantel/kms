From ac5ccf59fba97c9995310dea5e60fe50dd71b634 Mon Sep 17 00:00:00 2001
From: Sergey Strebulaev <s@vivantel.dev>
Date: Sun, 30 Aug 2026 01:48:48 +0000
Subject: [PATCH 08/15] docs: sync plugin manifest descriptions and README with
 the current 8 skills
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

plugin.json/.codex-plugin's description was still the original generic
placeholder from before this repo had a knowledge-management focus at
all — updated both (kept identical and agent-neutral, per why
docs/decisions/0008 genericized this field in the first place) to
actually describe the 8 skills. README's dogfooding section named only
bootstrap/steward; added lint/query since this repo's own docs/ are
just as checkable/queryable with them.
---
 README.md                              | 5 +++--
 plugins/kms/.claude-plugin/plugin.json | 4 ++--
 plugins/kms/.codex-plugin/plugin.json  | 2 +-
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/README.md b/README.md
index 117e9c5..594f06b 100644
--- a/README.md
+++ b/README.md
@@ -54,8 +54,9 @@ docs/{facts,decisions,guardrails,skills}/            # this repo's own knowledge
 `kms`'s design rationale — why each skill works the way it does, what
 must or must not happen, and what's currently true about the repo — is
 recorded as knowledge artifacts under `docs/`, maintained with the same
-`bootstrap`/`steward` skills this plugin ships. See
-[`AGENTS.md`](AGENTS.md) for the full structure and conventions.
+`bootstrap`/`steward` skills this plugin ships, and checkable with the
+same `lint`/`query` skills too. See [`AGENTS.md`](AGENTS.md) for the
+full structure and conventions.
 
 ## Contributing
 
diff --git a/plugins/kms/.claude-plugin/plugin.json b/plugins/kms/.claude-plugin/plugin.json
index efd9f44..99f7b3f 100644
--- a/plugins/kms/.claude-plugin/plugin.json
+++ b/plugins/kms/.claude-plugin/plugin.json
@@ -1,9 +1,9 @@
 {
   "name": "kms",
   "displayName": "KMS Dev Skills",
-  "description": "A growing toolkit of everyday development skills.",
+  "description": "Clarify and capture project decisions as durable knowledge, then bootstrap, steward, lint, and query the resulting fact/decision/guardrail system — plus attribute commits and generate changelogs from it.",
   "version": "0.2.0",
   "author": {
     "name": "sergemso"
   }
-}
\ No newline at end of file
+}
diff --git a/plugins/kms/.codex-plugin/plugin.json b/plugins/kms/.codex-plugin/plugin.json
index f2446ac..7885f5d 100644
--- a/plugins/kms/.codex-plugin/plugin.json
+++ b/plugins/kms/.codex-plugin/plugin.json
@@ -1,6 +1,6 @@
 {
   "name": "kms",
   "version": "0.2.0",
-  "description": "A growing toolkit of everyday development skills.",
+  "description": "Clarify and capture project decisions as durable knowledge, then bootstrap, steward, lint, and query the resulting fact/decision/guardrail system — plus attribute commits and generate changelogs from it.",
   "skills": "./skills"
 }
